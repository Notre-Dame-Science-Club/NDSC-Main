# Copy this to .env.local and fill in real values. Never commit .env.local —
# it now IS gitignored (it wasn't before this cleanup — see the reorg notes
# in docs/update-notes/ if you're wondering why that matters).

HOSTINGER_UPLOAD_URL=https://uploads.example.com/upload.php
UPLOAD_SECRET=change_me

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Admin panel password — use a real, unique, generated password, not a
# dictionary word / product name. This gates every /admin route.
ADMIN_PASSWORD=change_me

# ── Member OAuth sign-in ─────────────────────────────────────────────────
# Master switch, ON by default: the "Continue with Google" button shows on
# /login and /register unless you explicitly set it to 'false'. Set it to
# 'false' to disable OAuth and use only the normal email/password login.
# New OAuth users who have no `members` row yet are sent to /register/
# complete to collect their college roll, batch, etc.; existing members
# land straight on /dashboard.
# NEXT_PUBLIC_AUTH_ENABLE_OAUTH=false
# Which Supabase Auth provider to use. Anything not in the supported list
# falls back to 'google'. Providers: google, github, facebook, microsoft,
# apple, discord, gitlab, linkedin, twitter, bitbucket.
NEXT_PUBLIC_AUTH_OAUTH_PROVIDER=google
# Your public site origin (no trailing slash). Used to build the OAuth
# callback URL and the payment callback URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Since OAuth is ON by default, you must configure the Supabase dashboard:
#   1. Enable the provider under Authentication → Providers.
#   2. Add `${NEXT_PUBLIC_SITE_URL}/auth/callback` to Authentication → URL
#      Configuration → Redirect URLs.
