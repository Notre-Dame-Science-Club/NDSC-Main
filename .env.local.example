# Copy this to .env.local and fill in real values. Never commit .env.local —
# it now IS gitignored (it wasn't before this cleanup — see the reorg notes
# in docs/update-notes/ if you're wondering why that matters).

HOSTINGER_UPLOAD_URL=https://uploads.example.com/upload.php
UPLOAD_SECRET=change_me

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Admin panel password — use a real, unique, generated password, not a
# dictionary word / product name. This gates every /admin route.
ADMIN_PASSWORD=pls_change_me



# Your public site origin (no trailing slash). Used to build the payment
# callback URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Forgot-password (email + registered phone number). OFF unless set to exactly 'true'.
# Phone-number reset is weak (phone numbers are low-entropy and easy to look up), so leave it
# false in production and use the email reset link (Supabase resetPasswordForEmail) instead.
# Local dev (SUPABASE_ENV=local) has no GoTrue, so set it to true there to be able to reset passwords.
EASY_PASSWORD_RESET=false
# Automatic fallback: when the reset EMAIL can't be sent (Brevo down / out of quota / send error) the
# forgot-password page switches to the phone-number reset for that address only (signed 15-min token),
# and the server logs a loud alert. Default ON; set to 'false' to disable (users then see "try later").
# EASY_PASSWORD_RESET_FALLBACK=true
# Global daily cap on password-reset emails (anti-spam; protects the Brevo quota). Default 100.
# RESET_EMAIL_DAILY_CAP=100


# WhatsApp bulk sender (services/whatsapp-bulk). Run that service separately
# (see its README); it must be started with WA_API_TOKEN set to the same secret.
# Optional fallback only: the URL/token are normally added in Admin → Credentials.
# Auto-registration: the WhatsApp service (on Render) announces its own URL + token to the website
# each time it starts. Use the same long random value (16+ chars) as NDSC_REGISTER_SECRET on the service.
# SERVICE_REGISTER_SECRET=generate_another_long_random_string
# WHATSAPP_SERVICE_URL=http://127.0.0.1:3100
# WHATSAPP_SERVICE_TOKEN=generate_a_long_random_string

# Secret used to sign admin / organizer / team session cookies. REQUIRED in
# production: 32+ random characters (e.g. `openssl rand -base64 48`). Changing it
# logs every session out.
SESSION_SECRET=generate_a_long_random_string

# Hosts that database-supplied image/video URLs may point to (comma list,
# '*.example.com' allowed). Keep in sync with images.remotePatterns in
# next.config.ts. Leave unset to use the built-in defaults.
# NEXT_PUBLIC_ALLOWED_IMAGE_HOSTS=uploads.ndscbd.net,ndscbd.net,www.ndscbd.net,*.supabase.co,img.youtube.com

# Cloudflare Turnstile (captcha on /register). Free: Cloudflare dashboard ->
# Turnstile -> Add site (domain ndscbd.net, widget type "Managed").
# In production registration is REFUSED if the secret is missing (fail closed).
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
