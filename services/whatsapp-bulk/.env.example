# Server settings only. Nothing about messages, contacts, links or branding lives here:
# SIMs, credits, brand, logo and messages are all managed in the panel (stored in DATA_DIR).

# Port (Render sets this itself)
PORT=3100

# Where SIM logins, credits and history are stored. On Render: a persistent disk, e.g. /var/data
# DATA_DIR=./data

# ── Pick how people / the website get in ──
# Driven by the NDSC website: shared secret, sent as "Authorization: Bearer <token>"
# WA_API_TOKEN=
# Used on its own: open the panel in a browser and sign in with this password
# WA_ADMIN_PASSWORD=
# Neither set: panel only opens on this computer (127.0.0.1)

# ── Optional: tell the NDSC website where this service is, every time it starts ──
# NDSC_URL=https://your-website
# NDSC_REGISTER_SECRET=
# WA_PUBLIC_URL=https://this-service.example.com   (Render fills RENDER_EXTERNAL_URL itself)

# WA_HOST=0.0.0.0   (only when hosting yourself; Render does this automatically)
